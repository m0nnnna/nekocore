# server/.env on a realm box (and the dev box). `nekocore install` writes one
# from this; it is never overwritten by an update. Keep it private.

DOCKER_AC_ENV_FILE=conf/dist/env.ac
DOCKER_VOL_ETC=./env/dist/etc
DOCKER_VOL_LOGS=./env/dist/logs
DOCKER_VOL_DATA=./env/dist/data

DOCKER_DB_EXTERNAL_PORT=3306
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WEB_EXTERNAL_PORT=8088
# The MySQL root password. Pick a long random one before the first start
# (`nekocore install` does); changing it later means changing it inside MySQL too.
DOCKER_DB_ROOT_PASSWORD=change-me

DOCKER_USER=acore
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# Keeps the container/volume names (ac-*, azerothcore_ac-database) the
# existing installs use.
COMPOSE_PROJECT_NAME=azerothcore

# Which images run. `nekocore update` sets NEKOCORE_TAG (stable, edge or a
# version); the dev box builds its own with `docker compose build` (local).
NEKOCORE_IMAGES=ghcr.io/m0nnnna/nekocore
NEKOCORE_TAG=local

# The realm connection row (tools/server/apply_realmlist.sh): the public
# address the authserver hands players, and what LAN clients get instead.
# Leave REALM_ADDRESS empty to manage the row by hand.
REALM_NAME=NekoCore
REALM_ADDRESS=
REALM_LOCAL_ADDRESS=127.0.0.1
REALM_SUBNET_MASK=255.255.255.0
# Pins the realm's public name in the authserver container's hosts file
# (it resolves realmlist.address once at startup): "name:ip".
REALM_HOSTS_ENTRY=nekocore.invalid:127.0.0.1
# The "Server address" the website shows players.
NEKO_REALM_ADDRESS=wow1.nekos.farm
