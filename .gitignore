# Never commit game assets -- same rule open-wow-client's own tree follows,
# for the same reason: these are Blizzard's files, not ours to distribute.
data/dbc-reference/
data/inputs/
*.dbc
*.mpq
*.MPQ

# Rust build output. Cargo.lock is committed on purpose -- this is a binary,
# not a library, and the usual Rust convention is the other way round for
# exactly that reason.
/target

__pycache__/
*.pyc

# Live credentials for the website (DB passwords, RA/GM console login).
# These files exist locally for the deployed site but must never be
# committed, even by an accidental `git add -A`.
website/db_connect.php
website/db_connect_auth.php
website/db_connect_chars.php
website/db_connect_world.php
website/ra_config.php
website/mail_config.php
website/docker.env
website/downloads/*
!website/downloads/.gitkeep

# Third-party mods fetched at pinned commits by tools/third_party/fetch.py
# (Delves alone is ~600 MB of maps). Never vendored into this history.
/third-party/

# The live AzerothCore server checkout (its own git repo, moved here from
# D:\AzerothCore so everything nekocore lives in one folder). Never part of
# this repo -- our custom code reaches it via tools/server/sync_module.py,
# core-patches/, and server/docker-compose.override.yml.
/server/
