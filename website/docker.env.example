# Copy to docker.env (gitignored) and fill in. Read by the neko-website service.

# --- Mail (verification + password reset) ---
NEKO_SMTP_HOST=mail.example.org
NEKO_SMTP_PORT=587
NEKO_SMTP_ENCRYPTION=starttls
NEKO_SMTP_USER=help@nekos.farm
NEKO_SMTP_PASS=change-me
NEKO_SMTP_FROM=help@nekos.farm
NEKO_SMTP_FROM_NAME=NekoCore

