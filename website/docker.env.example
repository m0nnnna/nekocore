# Copy to docker.env (gitignored) and fill in. Read by the neko-website service.

# --- Site address (required) ---
# Verification and password-reset emails link here. Without it the site
# refuses to send them: building the link from the request's Host header would
# let anyone point someone else's reset link at their own server.
NEKO_BASE_URL=https://your-site.example

# --- Mail (verification + password reset) ---
NEKO_SMTP_HOST=mail.example.org
NEKO_SMTP_PORT=587
NEKO_SMTP_ENCRYPTION=starttls
NEKO_SMTP_USER=help@nekos.farm
NEKO_SMTP_PASS=change-me
NEKO_SMTP_FROM=help@nekos.farm
NEKO_SMTP_FROM_NAME=NekoCore

# --- Optional overrides (defaults shown) ---
# NEKO_DB_HOST=ac-database
# NEKO_DB_PORT=3306
# Use the limited account from db_user.sql, not root (and drop the
# NEKO_DB_USER/NEKO_DB_PASS lines from the compose service, which win over this file).
# NEKO_DB_USER=neko_web
# NEKO_DB_PASS=
# NEKO_DB_AUTH=acore_auth
# NEKO_DB_CHARS=acore_characters
# NEKO_DB_WORLD=acore_world
# NEKO_AUTH_HOST=ac-authserver
# NEKO_AUTH_PORT=3724
# NEKO_WORLD_HOST=ac-worldserver
# NEKO_WORLD_PORT=8085
# NEKO_REGISTRATIONS_OPEN=1
# NEKO_DISCORD_URL=https://discord.gg/W9cMwT4Ar9
# NEKO_WIKI_URL=https://wiki.nekos.farm/en/WoW
# NEKO_TZ=America/Chicago
