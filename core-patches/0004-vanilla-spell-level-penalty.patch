From 5cfa63032c3250658267a98b3f68ef20b1ed9d65 Mon Sep 17 00:00:00 2001
From: m0nnnna <mona@frennet.xyz>
Date: Sun, 4 Oct 2026 15:43:52 -0400
Subject: [PATCH] nekocore: Vanilla copies use 1.12's spell level penalty

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/server/game/Entities/Unit/Unit.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/server/game/Entities/Unit/Unit.cpp b/src/server/game/Entities/Unit/Unit.cpp
index 9283443ff..07d6d44f6 100644
--- a/src/server/game/Entities/Unit/Unit.cpp
+++ b/src/server/game/Entities/Unit/Unit.cpp
@@ -3208,6 +3208,16 @@ float Unit::CalculateLevelPenalty(SpellInfo const* spellProto) const
     if (!IsPlayer())
         return 1.0f;
 
+    // nekocore: Vanilla copies (build_era_spells.py, +300000) use 1.12's rule -- only spells
+    // below level 20 lose bonus, 3.75% per level short, whatever their MaxLevel; the
+    // downranking factor below came with 2.0 (vmangos SpellCaster::CalculateLevelPenalty)
+    if (spellProto->Id >= 300000 && spellProto->Id < 400000)
+    {
+        if (spellProto->SpellLevel <= 0 || spellProto->SpellLevel >= 20)
+            return 1.0f;
+        return 1.0f - (20.0f - spellProto->SpellLevel) * 0.0375f;
+    }
+
     if (spellProto->SpellLevel <= 0 || spellProto->SpellLevel >= spellProto->MaxLevel)
         return 1.0f;
 
-- 
