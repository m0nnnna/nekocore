+void Player::ApplyEraRatingMod(CombatRating cr, int32 value, bool apply, uint32 excludedMask)
+{
+    // Before ApplyRatingMod, whose UpdateRating reads it.
+    if (excludedMask & (1 << cr))
+        m_nekoVanillaExcludedRating[cr] += (apply ? value : -value);
+    ApplyRatingMod(cr, value, apply);
+}
