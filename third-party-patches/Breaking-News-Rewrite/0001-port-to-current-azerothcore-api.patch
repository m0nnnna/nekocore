--- a/src/BreakingNews.cpp
+++ b/src/BreakingNews.cpp
@@ -112,7 +112,22 @@ static void LoadBreakingNews()
         return;
     }
 
-    std::string formatted = fmt::format(_midPayloadFmt, title, body);
+    // Both strings end up inside single-quoted Lua literals in the payload;
+    // a stray ' or \ in the news text would otherwise break the whole
+    // script on the client (loadstring error at character select).
+    auto luaEscape = [](std::string const& in)
+    {
+        std::string out;
+        out.reserve(in.size() + 8);
+        for (char c : in)
+        {
+            if (c == '\\' || c == '\'')
+                out += '\\';
+            out += c;
+        }
+        return out;
+    };
+    std::string formatted = fmt::format(fmt::runtime(_midPayloadFmt), luaEscape(title), luaEscape(body));
 
     // Write under lock so CanPacketSend never reads a half-updated string
     std::lock_guard<std::mutex> lock(bn_Mutex);
