#
# nekocore module configuration
#

[worldserver]

########################################
# nekocore Configuration
########################################

# Nekocore.LockedMaps
#
#        Description: Comma-separated list of map ids players cannot enter (any means -- portal,
#                      hearthstone, GM teleport, group summon -- all funnel through the same
#                      check). GM accounts always pass through regardless of this setting, so a
#                      raid can still be tested/tuned while it's locked to everyone else.
#                      Live-reloadable: edit this file and run `.reload config` in-game, no
#                      restart needed. See src/RaidLock.cpp for the full reasoning.
#
#                      Common raid map ids: 409 Molten Core, 469 Blackwing Lair, 309 Zul'Gurub,
#                      533 Naxxramas (40-man), 531 Ahn'Qiraj Temple.
#
#        Default:     "" - nothing locked
#
Nekocore.LockedMaps = 409

# Nekocore.WorldEliteScaling.Enable
#
#        Description: Scales world elites, rare elites, and world bosses (creature_template rank
#                      ELITE/RAREELITE/WORLDBOSS) found on open-continent maps -- mod-autobalance
#                      never touches these at all, only instances. Scaling is snapshotted once,
#                      when the creature engages combat: everyone within
#                      Nekocore.WorldEliteScaling.Radius of it at that moment is counted (a
#                      spatial check, not a threat-table one, so a caster/healer standing back
#                      still counts even before they've landed a hit) and compared against a
#                      per-rank baseline to produce a health + outgoing-damage multiplier. See
#                      src/WorldEliteScaling.cpp for the full reasoning.
#
#        Default:     1 - enabled
#
Nekocore.WorldEliteScaling.Enable = 1

# Nekocore.WorldEliteScaling.Radius
#
#        Description: Yards around the creature to count players in, at the moment it engages
#                      combat. Generous by default (not melee-range) so ranged casters/healers
#                      standing at their normal fighting distance are still counted.
#
#        Default:     100
#
Nekocore.WorldEliteScaling.Radius = 100

# Nekocore.WorldEliteScaling.BaselineElite
# Nekocore.WorldEliteScaling.BaselineRareElite
# Nekocore.WorldEliteScaling.BaselineWorldBoss
#
#        Description: How many players each rank is considered "designed for". The multiplier
#                      applied is (players present / baseline), clamped to [MinMultiplier,
#                      MaxMultiplier) -- e.g. a solo player fighting a 3-baseline elite gets it
#                      scaled to 1/3 strength (before the Min/MaxMultiplier clamp).
#
#        Default:     3 / 5 / 15
#
Nekocore.WorldEliteScaling.BaselineElite = 3
Nekocore.WorldEliteScaling.BaselineRareElite = 5
Nekocore.WorldEliteScaling.BaselineWorldBoss = 15

# Nekocore.WorldEliteScaling.MinMultiplier
# Nekocore.WorldEliteScaling.MaxMultiplier
#
#        Description: Hard floor/ceiling on the health + outgoing-damage multiplier, regardless
#                      of how the player-count-to-baseline ratio computes. Prevents a creature
#                      pulled with zero nearby players (e.g. a pet dragging it in) from scaling
#                      to near-zero, and prevents a large crowd from scaling it beyond a
#                      reasonable ceiling.
#
#        Default:     0.4 / 1.5
#
Nekocore.WorldEliteScaling.MinMultiplier = 0.4
Nekocore.WorldEliteScaling.MaxMultiplier = 1.5

# Nekocore.WorldEliteScaling.ScaleXP
#
#        Description: Scale a world elite's kill XP by the same multiplier as its health, so a
#                      solo player who fought it at 40% health gets 40% of the XP. Only ever
#                      lowers XP (a multiplier above 1 leaves the template reward alone).
#
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#
Nekocore.WorldEliteScaling.ScaleXP = 1

# Nekocore.EraXPRate.Vanilla
# Nekocore.EraXPRate.TBC
# Nekocore.EraXPRate.WotLK
#
#        Description: Per-era baseline XP multiplier, read by mod-xp-changer's npc_xp_changer
#                      (modules/mod-xp-changer/src/XPChanger.cpp -- lives in a different module
#                      because that's where the NPC already is, but the era boundaries it checks
#                      are the same PROGRESSION_PRE_TBC / PROGRESSION_TBC_TIER_5 ones
#                      EraTalentGate.cpp and EraProgressionSync.cpp already use). The NPC's own
#                      "1.0x Normal" personal-preference option means "your current era's
#                      baseline" rather than a flat rate -- these three settings ARE that
#                      baseline, multiplied together with whatever personal rate (0.2x-2.0x) the
#                      player picked at the NPC.
#
#                      Deliberately not pre-tuned to any "researched" historical values -- there
#                      isn't a verified one to encode (only quest REWARD VALUES were ever
#                      catch-up-boosted by Blizzard, already corrected by mod-individual-
#                      progression's own QuestXPFix; the base kill-XP formula never was). These
#                      three numbers are a live tuning dial for however leveling should actually
#                      feel on this realm -- adjust and `.reload config`, no restart needed.
#
#        Default:     1.0 / 1.0 / 1.0 - no-op, identical to having no era baseline at all
#
Nekocore.EraXPRate.Vanilla = 1.0
Nekocore.EraXPRate.TBC = 1.0
Nekocore.EraXPRate.WotLK = 1.0

# Nekocore.Log.Enable
#
#        Description: Server-side combat logging for every dungeon and raid instance (src/NekoLog.cpp).
#                      Damage, healing, deaths, casts, auras and boss encounter boundaries are
#                      written to the characters database (nekolog_* tables) and shown on the
#                      website's Logs pages. Nothing comes from the client, so nothing can be
#                      edited. Live-reloadable.
#
#        Default:     1 - enabled
#
Nekocore.Log.Enable = 1

# Nekocore.Log.Auras
# Nekocore.Log.Casts
#
#        Description: Also record aura apply/remove and player spell casts. These are the bulk
#                      of the row volume; turn them off if the database is filling up faster
#                      than wanted. Damage/heal/death are always recorded while logging is on.
#
#        Default:     1 / 1
#
Nekocore.Log.Auras = 1
Nekocore.Log.Casts = 1

# Nekocore.Challenge.Enable
#
#        Description: Challenge runs (src/ChallengeRun.cpp, src/ChallengeScaling.cpp). An opt-in
#                      difficulty mode for 5-man dungeons you have outgrown: arm one at the
#                      Challenge Keeper (entry 9000101, beside Dungeon Dan in both capitals) and
#                      the instance you walk into pins every creature to your era's level cap
#                      (60 Vanilla / 70 TBC / 80 WotLK) and raises its health and damage. Clearing
#                      it raises the tier for next time; wiping lowers it. Every run is recorded
#                      in the characters DB (nekocore_challenge_*) and shown on the website's
#                      Challenges page, separately from the ordinary combat logs.
#
#                      IMPORTANT: the level part of this needs AutoBalance.LevelScaling = 1 in
#                      etc/modules/AutoBalance.conf. That is AutoBalance's own realm-wide switch
#                      and there is no per-instance version of it -- so it gets armed there and
#                      neutered everywhere except challenge runs by
#                      Nekocore.Challenge.SuppressLevelScalingOutsideChallenges below. Without
#                      it, challenge runs still get their health/damage bonuses but the mobs stay
#                      at their own level, and the worldserver logs an error saying so at startup.
#
#        Default:     1 - enabled
#
Nekocore.Challenge.Enable = 1

# Nekocore.Challenge.HealthStep
# Nekocore.Challenge.DamageStep
#
#        Description: How much harder each clear makes the next run, per tier, on the two levers
#                      that matter: creature maximum health and the damage creatures deal to
#                      players. Tier N multiplies them by (1 + step * N), so at the defaults tier
#                      5 is +75% health and +50% damage, tier 10 is +150% and +100%.
#
#                      Health deliberately climbs faster than damage: that makes a tier a longer
#                      fight before it is a lethal one, which is a DPS-and-endurance check rather
#                      than a one-shot check. Both compose on top of whatever AutoBalance is
#                      already doing for party size, they don't replace it.
#
#                      These are read fresh every time, never stored per tier, so changing them
#                      and running `.reload config` retunes every existing tier on the realm
#                      instead of leaving old characters on old numbers. (The multipliers a run
#                      actually used are recorded on its own row, so past runs keep their real
#                      difficulty.)
#
#        Default:     0.15 / 0.10
#
Nekocore.Challenge.HealthStep = 0.15
Nekocore.Challenge.DamageStep = 0.10

# Nekocore.Challenge.MaxTier
#
#        Description: Highest tier a character can reach per dungeon. 0 is an open-ended ladder --
#                      the wall is wherever a group actually stops being able to clear it, which
#                      is the point of the mode. Set a number if you would rather "maxed out" be
#                      a definite achievement.
#
#        Default:     0 - no ceiling
#
Nekocore.Challenge.MaxTier = 0

# Nekocore.Challenge.WipePenalty
#
#        Description: Whether a wipe (everyone in the instance dead at once) costs a tier. With
#                      this on, a character's tier is a claim they can currently beat it; with it
#                      off the ladder only ever goes up and a wipe just means retrying the same
#                      tier. Either way `best_tier` -- the hardest tier actually cleared, which is
#                      what the website's ladder ranks on -- never goes down.
#
#        Default:     1 - a wipe drops the tier by one (floor 0)
#
Nekocore.Challenge.WipePenalty = 1

# Nekocore.Challenge.ArmedMinutes
#
#        Description: How long an armed challenge waits before it lapses, in minutes. It is armed
#                      at the Keeper and spent by walking into the instance, so this only has to
#                      cover the trip there. 0 disables the timeout entirely (it still clears on
#                      logout).
#
#        Default:     30
#
Nekocore.Challenge.ArmedMinutes = 30

# Nekocore.Challenge.SuppressLevelScalingOutsideChallenges
#
#        Description: Keeps AutoBalance's level scaling off everywhere except challenge runs, by
#                      pushing the per-map skip ranges wide on every other dungeon (see the long
#                      comment at the top of src/ChallengeScaling.cpp for the mechanism).
#
#                      This exists so "a character levelling through Wailing Caverns finds it at
#                      its real level" is guaranteed by this module rather than by a setting in a
#                      conf file that isn't tracked in this repo. Two specific things it defends
#                      against: AutoBalance.conf lives in the gitignored server checkout, so a
#                      rebuilt box comes back with upstream defaults; and one of those defaults is
#                      `LevelScaling.DynamicLevel.PerInstance = "229 -1 -1 1, 230 0 0"`, whose
#                      `0 0` is a per-instance override that would force level scaling on in
#                      Blackrock Depths for everyone the moment the global switch was armed.
#
#                      Turn this off only if you actually want AutoBalance's realm-wide level
#                      scaling as well as challenge runs.
#
#        Default:     1 - normal dungeons are never level scaled
#
Nekocore.Challenge.SuppressLevelScalingOutsideChallenges = 1

# Nekocore.Challenge.DynamicLevelCeiling
# Nekocore.Challenge.DynamicLevelFloor
#
#        Description: How far above and below the bracket level a challenge dungeon's creatures
#                      may sit, handed to AutoBalance's dynamic level scaling. At the defaults a
#                      level-60 challenge puts the dungeon's own toughest creatures at 61 and its
#                      weakest no lower than 55 -- so the dungeon's internal pecking order
#                      survives (its trash still sits under its bosses), the whole thing just
#                      moves up wholesale. Set Floor to 0 to flatten everything onto exactly the
#                      bracket level instead.
#
#        Default:     1 / 5 - the same shape AutoBalance uses for dungeons
#
Nekocore.Challenge.DynamicLevelCeiling = 1
Nekocore.Challenge.DynamicLevelFloor = 5

# Nekocore.Challenge.Announce
#
#        Description: Whether the instance is told in chat when a challenge run starts, is cleared
#                      or is wiped. The Keeper's own replies to the player who armed it are always
#                      sent regardless.
#
#        Default:     1 - enabled
#
Nekocore.Challenge.Announce = 1

# Nekocore.PatchVersionFile
#
#        Description: File holding the client patch version players must have, written by
#                      tools/install_patch/install_client.py (data/generated/patch-version.txt,
#                      bind-mounted here by docker-compose.override.yml). The NekoPatchCheck addon
#                      reports the client's version at login; a mismatch gets an "update your
#                      patch" popup, no report at all gets a chat line. Missing or empty file turns
#                      the check off. Re-read on `.reload config`. See src/PatchCheck.cpp.
#
#        Default:     "/azerothcore/nekocore/patch-version.txt"
#
Nekocore.PatchVersionFile = "/azerothcore/nekocore/patch-version.txt"

# Nekocore.CcStagger.Ms
#
#        Description: In a five-man dungeon, once a mob starts a crowd control spell (stun,
#                      silence, fear, root, slow, ...), no mob of that instance (the same one
#                      included) may start another until that CC's duration (at most 10 sec) plus
#                      this long has passed. The wait shrinks with party size and is zero at a
#                      full group (Nekocore.CcStagger.FullGroup), so five players play unchanged
#                      and one player gets all of it. A blocked cast is just skipped. 0 turns it
#                      off. Separately, a lone player in a dungeon is never mind controlled.
#                      Pairs with AutoBalance.StatModifier*.CCDuration, which shortens each CC.
#                      See src/CcStagger.cpp.
#
#        Default:     3000
#
Nekocore.CcStagger.Ms = 3000

# Nekocore.CcStagger.FullGroup
#
#        Description: Party size at which the stagger window reaches zero.
#
#        Default:     5
#
Nekocore.CcStagger.FullGroup = 5

# Nekocore.CcStagger.Bosses
#
#        Description: Also stagger dungeon bosses. Off by default: their CC is part of the fight.
#
#        Default:     0
#
Nekocore.CcStagger.Bosses = 0
